# Confirmed production origin. Public artist pages need no API keys; marketing setup is below.
SITE_URL=https://ceo19.ma
# Preview deployments on non-Vercel hosts: set VERCEL_ENV=preview before building.

# Demo is the current exhibition. Live remains gated pending real-store integration tests.
SHOP_MODE=demo
# Future Storefront Web Components setup. Leave unset until a real store is connected.
# Configuration is read on the server; only these public values can reach the browser.
# SHOPIFY_STORE_DOMAIN=
# Canonical hostname only: your-store.myshopify.com (not a URL).
# SHOPIFY_COUNTRY=  # Optional configured Shopify Market country, uppercase ISO code.
# SHOPIFY_STOREFRONT_PUBLIC_TOKEN=  # Optional PUBLIC Headless channel token; browser-visible.
# SHOPIFY_CUSTOMER_ACCOUNT_URL=  # Exact hosted HTTPS URL from Settings > Customer accounts.
# No Admin/private token, API version, custom cart backend or payment secret is needed here.

# Real Shop waitlist storage. Server-only; never use NEXT_PUBLIC_ for these secrets.
# Vercel / serverless target: Neon Postgres over HTTPS. No Supabase account required.
# MARKETING_STORAGE=neon
# MARKETING_DATABASE_URL=  # Restricted ceo19_waitlist_app login; never the database owner URL.
# DATABASE_URL is accepted only when it already uses that restricted login.
# MARKETING_DATABASE_ADMIN_URL=  # PRIVATE LOCAL SETUP ONLY. Never deploy this admin credential.
# Local development / persistent-host option (not Vercel):
# MARKETING_STORAGE=sqlite
# MARKETING_SQLITE_PATH=/absolute/private/persistent/directory/waitlist.sqlite
# MARKETING_SQLITE_PERSISTENT=1  # Explicit durable-disk acknowledgement required in production.
# Never point this at public/, /tmp or a shared/network drive. Not supported on serverless hosts.
# Alternative remote adapter, only if deliberately selected:
# MARKETING_STORAGE=supabase
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=
# Alternatively, use the legacy server-only SUPABASE_SERVICE_ROLE_KEY.
# MARKETING_TOKEN_SECRET=  # Generate a persistent cryptographically random secret, at least 32 characters.
# MARKETING_PUBLIC_URL=https://ceo19.ma
# Optional confirmation delivery. No emails are claimed sent without a provider acknowledgement.
# MARKETING_EMAIL_PROVIDER=brevo
# BREVO_API_KEY=
# MARKETING_FROM_EMAIL=  # A real, verified sender in Brevo.
# MARKETING_FROM_NAME=CEO1.9
# MARKETING_OPERATOR_NAME=  # Set only after legal operator identity is verified.
# MARKETING_TRUSTED_IP_HEADER=  # Only if your hosting edge overwrites it (x-real-ip, x-forwarded-for, cf-connecting-ip).
